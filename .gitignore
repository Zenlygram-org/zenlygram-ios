# Zenlygram — build configs carry api_id/api_hash/team_id and the GPL source is published:
# only the placeholder template build-system/zenlygram-appstore.json is tracked; real values
# live in the ignored build-system/zenlygram-appstore.local.json (see appstore/SECRETS.md).
/build-system/zenlygram-*.json
!/build-system/zenlygram-appstore.json
/build-system/*.local.json
# Zenlygram — local-only files. Never committed.
/appstore/*.local.*
# Zenlygram — local-only screenshots. Not part of the published source.
/appstore/review-screenshots/
# Zenlygram — local-only working notes. Not part of the published source.
/docs/novagram-analysis/
/docs/audit/
# Zenlygram — Bazel convenience symlinks (bazel-<workspace>, e.g. bazel-swiftgram) point into
# the local output base (/private/var/tmp/_bazel_<user>/...).
/bazel-*

# Android is an independent Telegram Android fork, with its own Git history.
/android/
