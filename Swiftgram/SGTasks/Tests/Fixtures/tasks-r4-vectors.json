{
  "about": "Tasks wire R4 shared vectors: resources/contracts/tasks-sync.json revision 4 holds this object as x-r4-vectors and tests/Fixtures/tasks-r4/vectors.json is the same object. iOS copies it verbatim to Swiftgram/SGTasks/Tests/Fixtures/tasks-r4-vectors.json, Android to zenlygram-tests/tasks/fixtures/tasks-r4-vectors.json.",
  "version": 1,
  "hash_rule": {
    "domain": "zenlygram-tasks-business-v1",
    "canonical": "compact JSON [domain, principal, mutation_id, kind, arguments] as x-mutation-identity.canonical_json (raw UTF-8, unescaped '/', raw U+2028/U+2029); sha256 = lowercase hex SHA-256 of its UTF-8 bytes",
    "task.patch": "arguments = [task_id, [[field, value], ...] of set in content_order, the same pairs of expect]; an annotation value is [telegram_user_id, display_name] or null",
    "list.delete": "arguments = [list_id, base_revision], plus base_members_revision when the key is present (R4)",
    "key_order": "operation is the wire object; JSON key order is irrelevant (V-PATCH-1 lists set and expect out of content_order on purpose)",
    "wire": "the lowest X-Tasks-Wire that accepts the operation (3 = no header)"
  },
  "hash_vectors": [
