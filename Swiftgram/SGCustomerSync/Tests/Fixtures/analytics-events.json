{
  "taxonomy_version": 1,
  "types": {
    "product_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
    "base_plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "error_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "count": {"type": "integer", "min": 1, "max": 1000},
    "amount": {"type": "integer", "min": 0, "max": 100000},
    "duration_s": {"type": "integer", "min": 0, "max": 86400},
    "priority": {"type": "integer", "min": 0, "max": 4}
  },
  "enums": {
    "screen": ["zg.hub","zg.pro","zg.paywall","zg.link_account","zg.data_consent","zg.my_data","zg.account_delete",
               "zg.preferences","tasks.board","tasks.lists","tasks.task_editor","tasks.calendar","tasks.unsent_changes",
               "tasks.invitations","tasks.archive","vault.unlock","vault.chats","vault.settings","chat_lock.unlock",
               "chat_lock.settings","edit_history.message","edit_history.settings","calls.recordings",
               "tg.chat_list","tg.contacts","tg.calls","tg.settings"],
    "feature": ["tasks","tasks_cloud","tasks_calendar","vault","chat_lock","edit_history","deleted_messages",
                "call_recording","translation","unread_reminder","stranger_inbox","foreign_user_block","message_filter",
                "ocr","dictation","apk_protection","chat_tools","folders","round_video_from_gallery",
                "story_confirmation","send_confirmation","app_icon"],
    "error_domain": ["network","backend","link","tasks_sync","tasks_migration","purchase","consent_upload",
                     "profile_sync","events_upload","storage","vault","chat_lock","other"],
    "rail": ["apple","google","web"],
    "tasks_scope": ["cloud","local"]
  },
  "events": {
    "app.session_start":    {"trigger": {"enum": ["launch","foreground","account_switch"], "required": true}},
    "app.session_end":      {"duration_s": {"type": "duration_s", "required": true},
                             "reason": {"enum": ["background","account_switch","logout","terminate"], "required": true}},
    "screen.view":          {"screen": {"enum": "screen", "required": true}},
    "feature.toggle":       {"feature": {"enum": "feature", "required": true}, "enabled": {"type": "boolean", "required": true}},
    "feature.used":         {"feature": {"enum": "feature", "required": true}},
    "tasks.task_created":   {"scope": {"enum": "tasks_scope", "required": true}, "has_due": {"type": "boolean", "required": true},
                             "priority": {"type": "priority", "required": true}, "in_list": {"type": "boolean", "required": true}},
    "tasks.task_completed": {"scope": {"enum": "tasks_scope", "required": true}, "reopened": {"type": "boolean", "required": true}},
    "tasks.task_deleted":   {"scope": {"enum": "tasks_scope", "required": true}},
    "tasks.list_created":   {"scope": {"enum": "tasks_scope", "required": true}},
    "tasks.list_deleted":   {"scope": {"enum": "tasks_scope", "required": true}, "tasks": {"type": "amount", "required": true}},
    "tasks.shared":         {"action": {"enum": ["invite_sent","invite_accepted","invite_declined","left","revoked","blocked"], "required": true}},
    "tasks.migration":      {"phase": {"enum": ["started","completed","failed"], "required": true},
                             "lists": {"type": "amount"}, "tasks": {"type": "amount"}, "skipped": {"type": "amount"},
                             "duration_s": {"type": "duration_s"}, "error_code": {"type": "error_code"}},
    "tasks.sync_issue":     {"kind": {"enum": ["conflict_auto_resolved","conflict_manual","stalled","blocked_creation","invalid"], "required": true},
                             "count": {"type": "count", "required": true}},
    "vault.unlocked":       {"method": {"enum": ["pin","password","biometric"], "required": true}},
    "vault.chat_added":     {},
    "vault.chat_removed":   {},
    "chat_lock.lock_set":   {"method": {"enum": ["pin","password"], "required": true}, "biometric": {"type": "boolean", "required": true}},
    "chat_lock.unlocked":   {"method": {"enum": ["pin","password","biometric"], "required": true}},
    "chat_lock.lock_removed": {},
    "edit_history.viewed":  {"kind": {"enum": ["edited","deleted"], "required": true}},
    "pro.screen_view":      {"source": {"enum": ["settings","paywall","feature_gate","tasks","link","deeplink","other"], "required": true},
                             "mode": {"enum": ["free","paid"], "required": true}},
    "pro.plan_select":      {"product_id": {"type": "product_id", "required": true}, "rail": {"enum": "rail", "required": true},
                             "base_plan_id": {"type": "base_plan_id"}},
    "pro.purchase_start":   {"product_id": {"type": "product_id", "required": true}, "rail": {"enum": "rail", "required": true},
                             "base_plan_id": {"type": "base_plan_id"}},
    "pro.purchase_success": {"product_id": {"type": "product_id", "required": true}, "rail": {"enum": "rail", "required": true},
                             "base_plan_id": {"type": "base_plan_id"}, "trial": {"type": "boolean", "required": true}},
    "pro.purchase_fail":    {"product_id": {"type": "product_id", "required": true}, "rail": {"enum": "rail", "required": true},
                             "base_plan_id": {"type": "base_plan_id"},
                             "reason": {"enum": ["cancelled","pending","failed","not_allowed","unavailable"], "required": true},
                             "error_code": {"type": "error_code"}},
    "pro.restore":          {"rail": {"enum": "rail", "required": true}, "outcome": {"enum": ["restored","nothing","failed"], "required": true},
                             "error_code": {"type": "error_code"}},
    "pro.trial_start":      {"outcome": {"enum": ["started","refused","failed"], "required": true}, "error_code": {"type": "error_code"}},
    "link.attempt":         {"trigger": {"enum": ["auto","manual"], "required": true}, "method": {"enum": ["attest","code"], "required": true},
                             "outcome": {"enum": ["success","failed"], "required": true}, "error_code": {"type": "error_code"},
                             "duration_s": {"type": "duration_s"}},
    "error.occurred":       {"domain": {"enum": "error_domain", "required": true}, "code": {"type": "error_code", "required": true},
                             "count": {"type": "count", "required": true}}
  }
}
